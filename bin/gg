#!/bin/bash
#
# gg wrapper - launches gg-core CLI
#
# Usage:
#   gg <command> [options]
#
# This wrapper runs gg-core from the source directory.
# It auto-detects its location so it works on any machine.

set -e

# Platform-specific PATH additions
if [ "$(uname -s)" = "Darwin" ]; then
    export PATH="/opt/homebrew/bin:$HOME/.kimi-code/bin:$PATH"
fi

# Determine gg-core directory
# 1. If GG_CORE_DIR is set, use it
# 2. If this script is inside a gg-core/bin directory, use parent
# 3. Fall back to ~/gg-core
if [ -n "${GG_CORE_DIR}" ]; then
    GG_DIR="${GG_CORE_DIR}"
else
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    PARENT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
    if [ "$(basename "$PARENT_DIR")" = "gg-core" ] && [ -d "$PARENT_DIR/src/gg_core" ]; then
        GG_DIR="$PARENT_DIR"
    else
        GG_DIR="${HOME}/gg-core"
    fi
fi

if [ ! -d "$GG_DIR" ]; then
    echo "Error: gg-core directory not found at $GG_DIR" >&2
    exit 1
fi

# Use the venv Python directly (avoids uv run recursion)
VENV_PYTHON="$GG_DIR/.venv/bin/python"
if [ -x "$VENV_PYTHON" ]; then
    export PYTHONPATH="${GG_DIR}/src"
    cd "$GG_DIR"
    exec "$VENV_PYTHON" -c "
import sys
from gg_core.cli.run import run
sys.argv = ['gg'] + sys.argv[1:]
sys.exit(run())
" "$@"
fi

# Fallback: uv run (should not happen if venv exists)
if command -v uv &> /dev/null; then
    cd "$GG_DIR"
    export PYTHONPATH="${GG_DIR}/src"
    exec uv run -- python -c "
import sys
from gg_core.cli.run import run
sys.argv = ['gg'] + sys.argv[1:]
sys.exit(run())
" "$@"
fi

echo "Error: No Python environment found in $GG_DIR/.venv" >&2
exit 1

#!/bin/bash
#
# gg wrapper - launches gg-core CLI
#
# Usage:
#   gg <command> [options]
#
# This wrapper runs gg-core from the source directory.
#

set -e

# Hardcoded path to gg-core source
GG_DIR="${HOME}/gg-core"

# Use uv run if available
if command -v uv &> /dev/null; then
    cd "$GG_DIR"
    exec uv run gg "$@"
fi

# Fallback: try python with direct import
if command -v python3 &> /dev/null; then
    PYTHONPATH="${GG_DIR}/src" exec python3 -c "from gitgantt.cli.run import run; import sys; sys.exit(run())"
fi

echo "Error: Neither uv nor python3 found" >&2
exit 1

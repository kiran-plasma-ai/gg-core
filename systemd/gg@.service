[Unit]
Description=GitGantt Session for %i

[Service]
Type=oneshot
RemainAfterExit=yes
# Set PATH for agent to find gitgantt and other tools
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
# Start tmux session with agent
ExecStart=/bin/sh -c 'export PATH=%h/.local/bin:$PATH; TMUX_SESSION=%i; AGENT_CMD="${AGENT_CMD:-kimi-cli -S %i --yes}"; /usr/bin/tmux kill-session -t "$TMUX_SESSION" 2>/dev/null; /usr/bin/tmux new-session -d -s "$TMUX_SESSION" -c "%h/%i" "$AGENT_CMD"'
# Stop tmux session
ExecStop=/usr/bin/tmux kill-session -t %i
KillMode=none
Slice=development.slice

[Install]
WantedBy=default.target
